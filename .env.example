#Default
#POLL_INTERVAL=5000
#PROVIDER__TYPE=Zip

#Filesystem
#PROVIDER__TYPE=Filesystem

#Local MinIO (switchboard-backend/docker-compose.yml). Same bucket and prefix as the backend's
#S3_BUCKET and S3_LIVE_PREFIX.
POLL_INTERVAL=2000
PROVIDER__TYPE=S3
PROVIDER__BUCKET=rules-dev
PROVIDER__PREFIX=live
PROVIDER__REGION=us-east-1
PROVIDER__ENDPOINT=http://127.0.0.1:9100
PROVIDER__FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=rustfs_username
AWS_SECRET_ACCESS_KEY=rustfs_password

#S3 Example
#PROVIDER__TYPE=S3
#PROVIDER__BUCKET=gorules-test-release
#PROVIDER__REGION=eu-west-1
#PROVIDER__ACCESS_KEY_ID=<access-key-id>
#PROVIDER__SECRET_ACCESS_KEY=<secret-access-key>

#Azure (shared key or SAS)
#PROVIDER__TYPE=AzureStorage
#PROVIDER__CONNECTION_STRING=<connection-string>
#PROVIDER__CONTAINER=<container-name>

#Azure (IAM / Entra ID — identity via DefaultAzureCredential: AZURE_TENANT_ID/
#AZURE_CLIENT_ID/AZURE_CLIENT_SECRET env vars, managed identity, or `az login`;
#the identity needs the 'Storage Blob Data Reader' role)
#PROVIDER__TYPE=AzureStorage
#PROVIDER__ACCOUNT_NAME=<storage-account-name>
#PROVIDER__CONTAINER=<container-name>

#GCS
#PROVIDER__TYPE=GCS
#PROVIDER__BASE64_CONTENTS=<base64-credential-contents>
#PROVIDER__BUCKET=<bucket-name>